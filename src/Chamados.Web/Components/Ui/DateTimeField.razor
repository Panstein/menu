@* Data/hora com add-on de calendário à esquerda. *@
<div class="ui-input-group">
    <button type="button" class="ui-addon ui-addon-btn" title="Abrir calendário" disabled="@Disabled"
            onclick="try { this.nextElementSibling.showPicker() } catch { this.nextElementSibling.focus() }">
        <i class="bi bi-calendar3"></i>
    </button>
    <input id="@Id" class="ui-input ui-input-date" type="@(DateOnly ? "date" : "datetime-local")"
           value="@FormatValue()" disabled="@Disabled" @onchange="OnChanged" />
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public bool DateOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? FormatValue() => Value?.ToString(DateOnly ? "yyyy-MM-dd" : "yyyy-MM-ddTHH:mm");

    private async Task OnChanged(ChangeEventArgs e)
    {
        Value = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
        await ValueChanged.InvokeAsync(Value);
    }
}
